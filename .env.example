# Copy to .env.local (prod-shaped) or .env.test (local Docker). Never commit those files.
# Values are names only — fill from the team’s secret store, not from git.

# --- required ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Local Docker only (.env.test). The local-DB guard checks this, not DATABASE_URL.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54622/postgres

# Public site URL. SITE_URL is read at runtime for password-reset links (preferred).
SITE_URL=https://ckrea.com.co
NEXT_PUBLIC_SITE_URL=https://ckrea.com.co

# --- cron (Vercel sends this as Bearer) ---
CRON_SECRET=

# --- email ---
BREVO_API_KEY=

# --- file storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ckrea-portal

# --- errors / analytics (optional in local) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- web push (optional in local) ---
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- leftover manual ERP top-up (scripts/sync-csf.ts). Not required to run the app. ---
# CSF_BASE_URL=
# CSF_API_KEY=
